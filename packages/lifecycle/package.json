{
  "name": "@cloudsforge/lifecycle",
  "version": "1.0.0",
  "description": "Readiness, liveness and drain. The twenty lines that are currently absent from every CloudsForge service.",
  "license": "MIT",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": { ".": "./src/index.ts" },
  "publishConfig": {
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
    "access": "public"
  },
  "files": ["dist"],
  "engines": { "node": ">=22" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/*.test.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm build"
  }
}
