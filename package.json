{
  "name": "@cloudsforge/runtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "typecheck": "pnpm -r typecheck && tsc -p tools/tsconfig.json",
    "test": "pnpm -r test && node --import tsx --test tools/*.test.ts",
    "build": "pnpm -r build",
    "check": "pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
